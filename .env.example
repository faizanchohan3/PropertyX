# ---- Core ----
# Local dev uses the embedded Postgres started by `npm run db:start`.
DATABASE_URL=postgres://propertyx:propertyx_dev@127.0.0.1:54329/propertyx
# Hosted Postgres (e.g. Supabase): DATABASE_URL = pooled "Transaction" URL (port 6543) for the app,
# DIRECT_URL = "Session"/direct URL (port 5432) used by migrations and seeding. TLS is enabled automatically.
# DIRECT_URL=
# Used by integration tests (created automatically by db:start)
TEST_DATABASE_URL=postgres://propertyx:propertyx_dev@127.0.0.1:54329/propertyx_test
APP_URL=http://localhost:3100
# REQUIRED in production: long random string (openssl rand -base64 48)
AUTH_SECRET=change-me-dev-secret-at-least-32-characters-long

# ---- Storage ----
# local | s3 (s3 adapter is a documented extension point)
STORAGE_DRIVER=local
# Private documents (CNIC, ownership papers) are stored here and never served statically
STORAGE_PRIVATE_DIR=./storage/private
STORAGE_PUBLIC_DIR=./storage/public

# ---- AI (optional; the built-in rules engine works without any key) ----
# anthropic | openai | gemini | rules
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Payments (comma separated list of enabled gateways) ----
# sandbox is a built-in test gateway; jazzcash / easypaisa / payfast need merchant credentials
PAYMENT_GATEWAYS=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENDPOINT=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf

# ---- Notifications (console = log to server output + outbox table) ----
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
PUSH_PROVIDER=console

# ---- Maps ----
# Tiles default to OpenStreetMap. Nearby places use the public Overpass API.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
